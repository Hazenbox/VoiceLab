# ============================================
# VOICE DESIGNER - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your API keys

# ============================================
# SERVER-SIDE ONLY (Vercel Environment Variables)
# ============================================
# These variables are used by /api serverless functions
# They are NOT exposed to the browser (no VITE_ prefix)

# Alibaba DashScope API Key (for TTS and LLM)
# Get your key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ElevenLabs API Key (Primary TTS Provider)
# Get your key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Gemini API Key
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (optional)
# Get your key from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# HuggingFace API Key (FREE tier available)
# Get your key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Inworld AI API Key (optional)
# Get your key from: https://studio.inworld.ai/
INWORLD_API_KEY=your_inworld_api_key_here

# Inworld Character Path
# Format: workspaces/{WORKSPACE_ID}/characters/{character_name}
INWORLD_CHARACTER=workspaces/default/characters/your-character

# ============================================
# CLIENT-SIDE (VITE_ prefix - bundled into JS)
# ============================================
# Only non-sensitive configuration should use VITE_ prefix
# These values are visible in the browser

# TTS Provider Selection
# Options: 'elevenlabs', 'alibaba', 'gemini'
VITE_TTS_PROVIDER=elevenlabs

# Conversation Provider Selection
# Options: 'alibaba', 'gemini'
VITE_CONVERSATION_PROVIDER=alibaba

# Default LLM Provider for Copy Generation
# Options: 'qwen-text', 'huggingface', 'gemini-text', 'inworld'
VITE_DEFAULT_LLM_PROVIDER=qwen-text

# LLM Fallback Chain (comma-separated, in priority order)
# Qwen (DashScope) is primary, HuggingFace as fallback
VITE_LLM_FALLBACK_CHAIN=qwen-text,huggingface

# HuggingFace Model Selection
# Options: qwen25-7b, gemma2-2b, deepseek-r1, llama33-70b, glm4-9b, mistral-7b
VITE_HUGGINGFACE_MODEL=qwen25-7b

# OpenAI Model Selection
VITE_OPENAI_MODEL=gpt-4o-mini

# Claude Model Selection
VITE_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ============================================
# LOCAL DEVELOPMENT ONLY
# ============================================
# These are only used when running locally with the proxy server
# Not needed for Vercel deployment

# WebSocket Proxy Configuration
VITE_WS_PROXY_HOST=localhost
VITE_WS_PROXY_PORT=3001
WS_PROXY_PORT=3001

# ============================================
# RELIABILITY CONFIGURATION (optional)
# ============================================
# Circuit breaker settings
VITE_CIRCUIT_FAILURE_THRESHOLD=5
VITE_CIRCUIT_SUCCESS_THRESHOLD=3
VITE_CIRCUIT_TIMEOUT_MS=30000

# Retry settings
VITE_RETRY_MAX_ATTEMPTS=3
VITE_RETRY_BASE_DELAY_MS=1000

# Cache settings
VITE_CACHE_MAX_SIZE=100
VITE_CACHE_TTL_MS=300000

# ============================================
# CONVEX BACKEND (Shared Data Layer)
# ============================================
# Get your URL from: https://dashboard.convex.dev/
# Run: npx convex dev (to create a project and get the URL)
VITE_CONVEX_URL=

# ============================================
# ADMIN PANEL
# ============================================
# Passphrase for accessing /admin route
# IMPORTANT: Use a strong, unique passphrase - never use defaults in production!
# Set ADMIN_PASSPHRASE in Vercel dashboard for production
# VITE_ADMIN_PASSPHRASE is only for local development fallback
VITE_ADMIN_PASSPHRASE=your_secure_passphrase_here

# ============================================
# FEATURE FLAGS (Phase Rollout)
# ============================================
# Enable/disable features independently
VITE_ENABLE_CONVEX_SYNC=false
VITE_ENABLE_PERSONA=false
VITE_ENABLE_KNOWLEDGE_BASE=false
VITE_ENABLE_LEARNING=false
# Note: RAG (Semantic Vector Search) is always enabled and requires:
# - HUGGINGFACE_API_KEY set in Convex dashboard
# - Embeddings generated via: npx convex run embeddings:backfillEmbeddings
# Conversational-first mode: general-purpose assistant with conditional Jio guardrails
# When enabled, users can chat about any topic; Jio brand rules apply only to content generation
VITE_ENABLE_CONVERSATIONAL_MODE=true
