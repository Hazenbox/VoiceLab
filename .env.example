# TTS Provider Configuration
# Options: 'alibaba' or 'gemini'
VITE_TTS_PROVIDER=alibaba
VITE_CONVERSATION_PROVIDER=alibaba

# Alibaba DashScope API Key
# Get your key from: https://dashscope.console.aliyun.com/ (Singapore region)
# or https://bailian.console.alibabacloud.com/ (Beijing region)
VITE_DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Google Gemini API Key (optional, for fallback)
# Get your key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# WebSocket Proxy Configuration
# The proxy server handles DashScope WebSocket authentication from browsers
# (Browser WebSockets cannot send custom HTTP headers)
VITE_WS_PROXY_HOST=localhost
VITE_WS_PROXY_PORT=3001
WS_PROXY_PORT=3001
