# ============================================
# DEVELOPMENT ENVIRONMENT
# ============================================
# Used when running: npm run dev
# Copy to .env.local and add your API keys for local development

# Feature flags - all enabled for development
VITE_ENABLE_CONVEX_SYNC=true
VITE_ENABLE_PERSONA=true
VITE_ENABLE_KNOWLEDGE_BASE=true
VITE_ENABLE_LEARNING=true
VITE_ENABLE_RAG=true
VITE_ENABLE_CONVERSATIONAL_MODE=true

# Reliability - relaxed for faster iteration
VITE_CIRCUIT_FAILURE_THRESHOLD=10
VITE_CIRCUIT_SUCCESS_THRESHOLD=2
VITE_CIRCUIT_TIMEOUT_MS=60000
VITE_RETRY_MAX_ATTEMPTS=2
VITE_RETRY_BASE_DELAY_MS=500
VITE_CACHE_MAX_SIZE=50
VITE_CACHE_TTL_MS=60000

# Observability - verbose logging, no Sentry
# VITE_SENTRY_DSN= (leave empty for dev)
VITE_APP_VERSION=dev

# TTS/Conversation providers
VITE_TTS_PROVIDER=elevenlabs
VITE_CONVERSATION_PROVIDER=alibaba
