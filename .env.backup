# ============================================
# TTS PROVIDER CONFIGURATION
# ============================================
VITE_TTS_PROVIDER=elevenlabs
VITE_CONVERSATION_PROVIDER=alibaba

# ElevenLabs Voice Configuration (optional, defaults provided)
# VITE_ELEVENLABS_DEFAULT_VOICE=pNInz6obpgDQGcFmaJgB
# VITE_ELEVENLABS_HINDI_VOICE=pNInz6obpgDQGcFmaJgB

# ============================================
# API KEYS - SERVER-SIDE ONLY
# ============================================
# IMPORTANT: API keys are now server-side only (no VITE_ prefix)
# Set these in Vercel Environment Variables for production
# For local development, the proxy server reads from process.env
#
# Required keys (set in Vercel dashboard or .env.local):
# - ELEVENLABS_API_KEY
# - DASHSCOPE_API_KEY
# - GEMINI_API_KEY
# - OPENAI_API_KEY
# - CLAUDE_API_KEY
# - HUGGINGFACE_API_KEY
# - INWORLD_API_KEY

# ============================================
# LLM PROVIDER CONFIGURATION
# ============================================

# Model Configuration (safe to expose - no secrets)
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Available HuggingFace models: qwen25-7b, gemma2-2b, deepseek-r1, llama33-70b, glm4-9b, mistral-7b
VITE_HUGGINGFACE_MODEL=qwen25-7b
VITE_HUGGINGFACE_BASE_URL=https://router.huggingface.co

# Default LLM provider for copy generation (qwen-text, huggingface, gemini-text, inworld)
VITE_DEFAULT_LLM_PROVIDER=qwen-text

# LLM Fallback chain (comma-separated, in priority order)
VITE_LLM_FALLBACK_CHAIN=qwen-text,huggingface

# ============================================
# INWORLD AI CONFIGURATION
# ============================================
# Character path (safe to expose - not a secret)
VITE_INWORLD_CHARACTER=workspaces/default/characters/copy-generator

# ============================================
# PROXY SERVER CONFIGURATION
# ============================================
# The proxy server handles authentication for browser WebSocket connections
VITE_WS_PROXY_HOST=localhost
VITE_WS_PROXY_PORT=3001
WS_PROXY_PORT=3001

# ============================================
# CONVEX BACKEND
# ============================================
# Convex deployment URL (from .env.local or Convex dashboard)
VITE_CONVEX_URL=https://tidy-guanaco-955.eu-west-1.convex.cloud

# ============================================
# ADMIN AUTHENTICATION
# ============================================
# Admin panel passphrase for server-side authentication (Vercel API routes)
# IMPORTANT: Set a strong, unique passphrase in Vercel Environment Variables
# For local development, create .env.local and set your own passphrase
# NEVER use the example passphrase in production!
#
# Required in production (set via Vercel dashboard):
# ADMIN_PASSPHRASE=your_strong_unique_passphrase_here
#
# For local dev fallback (when Vercel API is not available):
# VITE_ADMIN_PASSPHRASE=your_local_dev_passphrase

# ============================================
# SERVER-SIDE API KEYS (for local development proxy)
# ============================================
# These are read by the proxy server (server/wsProxy.mjs) and Vercel functions
# In production, set these in Vercel Environment Variables
# IMPORTANT: Never commit real keys to git - use .env.local for local development
#
# Copy these to .env.local and fill in your own values:
# ELEVENLABS_API_KEY=your_key_here
# DASHSCOPE_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here
# HUGGINGFACE_API_KEY=your_key_here
# INWORLD_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# CLAUDE_API_KEY=your_key_here

# ============================================
# PHASE 0-5 FEATURE FLAGS
# ============================================
# Set to 'true' to enable, remove or set to 'false' to disable.
# Disabling a feature gracefully falls back to defaults (no crashes).
VITE_ENABLE_CONVEX_SYNC=true
VITE_ENABLE_PERSONA=true
VITE_ENABLE_KNOWLEDGE_BASE=true
VITE_ENABLE_LEARNING=true
VITE_ENABLE_RAG=true
VITE_ENABLE_CONVERSATIONAL_MODE=true

# ============================================
# RELIABILITY CONFIGURATION
# ============================================
# Circuit breaker settings
VITE_CIRCUIT_FAILURE_THRESHOLD=5
VITE_CIRCUIT_SUCCESS_THRESHOLD=3
VITE_CIRCUIT_TIMEOUT_MS=30000

# Retry settings
VITE_RETRY_MAX_ATTEMPTS=3
VITE_RETRY_BASE_DELAY_MS=1000

# Cache settings
VITE_CACHE_MAX_SIZE=100
VITE_CACHE_TTL_MS=300000

# ============================================
# OBSERVABILITY
# ============================================
# Sentry error tracking (get DSN from https://sentry.io)
# Leave empty to disable Sentry
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Application version (set via CI/CD)
VITE_APP_VERSION=1.0.0

# ============================================
# PHASE 6: SERVER-SIDE PIPELINE
# ============================================
# When enabled, runs the generation pipeline on Vercel serverless
# instead of client-side. Provides better security (API keys server-only)
# and enables SSE streaming for real-time responses.
#
# Default: false (client-side pipeline)
# Set to 'true' to enable server-side execution
# VITE_SERVER_SIDE_PIPELINE=true

# ============================================
# DISTRIBUTED RATE LIMITING (Optional)
# ============================================
# For production with high traffic, use Upstash Redis for distributed
# rate limiting across all serverless instances.
#
# 1. Create account at https://console.upstash.com
# 2. Create a Redis database
# 3. Copy REST URL and Token
# 4. Install packages: npm install @upstash/ratelimit @upstash/redis
#
# Without Upstash, falls back to in-memory rate limiting (per-instance)
# which is sufficient for development and low-traffic scenarios.
#
# Required in production (set via Vercel dashboard):
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
