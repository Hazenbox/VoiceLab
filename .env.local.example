# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your own values
# NEVER commit .env.local to git

# Convex deployment (from Convex dashboard)
CONVEX_DEPLOYMENT=dev:your-convex-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# ============================================
# API KEYS (Server-side only)
# ============================================
# These are used by the local proxy server and Vercel functions
# In production, set these in Vercel Environment Variables

# DashScope/Qwen (Required for default LLM)
DASHSCOPE_API_KEY=sk-your-dashscope-key

# HuggingFace (Required for fallback LLM)
HUGGINGFACE_API_KEY=hf_your-huggingface-key

# Google Gemini (Optional)
GEMINI_API_KEY=your-gemini-key

# ElevenLabs TTS (Optional)
ELEVENLABS_API_KEY=your-elevenlabs-key

# OpenAI (Optional)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic Claude (Optional)
CLAUDE_API_KEY=sk-ant-your-claude-key

# Inworld AI (Optional)
INWORLD_API_KEY=your-inworld-base64-key

# ============================================
# ADMIN AUTHENTICATION
# ============================================
# Server-side passphrase for admin panel
ADMIN_PASSPHRASE=your-secure-passphrase
